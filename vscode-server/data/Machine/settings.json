{
  "github.copilot.enable": {
    "*": true
  },
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/usr/bin/zsh"
    }
  },
  "workbench.colorTheme": "Visual Studio Dark",
  "chat.agent.enabled": true,
  "chat.commandCenter.enabled": true,
  "remote.autoForwardPortsSource": "hybrid",
  "chat.tools.global.autoApprove": true,
  "chat.agent.thinkingStyle": "collapsedPreview",
  "chat.tools.terminal.outputLocation": "terminal",
  "inlineChat.defaultModel": "Claude Sonnet 4.5 (copilot)",
  "chat.tools.terminal.idlePollInterval": 10000,
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/.vs/**": true,
    "**/.vscode/**": true,
    "**/vendor/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/target/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/coverage/**": true,
    "**/__pycache__/**": true,
    "**/*.egg-info/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/packages/**": true,
    "**/.nyc_output/**": true
  },
}