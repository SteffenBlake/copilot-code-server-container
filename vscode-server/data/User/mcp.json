{
	"servers": {
		"cli-mcp-mapper": {
			"type": "stdio",
			"command": "cli-mcp-mapper",
			"args": []
		},
		"aspire": {
			"type": "stdio",
			"command": "aspire",
			"args": [
				"mcp",
				"start"
			],
			"env": {
				"DOTNET_ROOT": "${DOTNET_ROOT}"
			}
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--browser",
				"firefox"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"vscode-mcp/vscode-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@vscode-mcp/vscode-mcp-server@latest"
			],
			"version": "latest"
		}
	},
	"inputs": []
}